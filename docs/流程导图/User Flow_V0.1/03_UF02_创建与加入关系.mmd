flowchart TB
    START["用户第一次进入产品"] --> INVITE{"是否通过邀请进入？"}

    INVITE -->|"否"| A1["创建个人身份"]
    A1 --> A2["创建一个关系空间"]
    A2 --> A3["系统生成邀请码或邀请链接"]
    A3 --> A4["用户分享给情侣、朋友或室友"]
    A4 --> A5["等待成员加入"]

    INVITE -->|"是"| B1{"是否已有个人身份？"}
    B1 -->|"没有"| B2["创建个人身份"]
    B1 -->|"已有"| B3["读取邀请信息"]
    B2 --> B3
    B3 --> B4["了解是谁邀请、将加入什么关系"]
    B4 --> B5["确认加入"]

    B5 --> C1["关系建立成功"]
    C1 --> C2["双方或小组成员知道新成员已加入"]
    C2 --> C3["进入日常喝水状态"]

    A5 --> C1
