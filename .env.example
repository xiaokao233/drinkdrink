# Generate a long random value and add it to Vercel as AUTH_TOKEN_SECRET.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Resend email delivery. The sender domain must be verified in Resend first.
RESEND_API_KEY=re_replace_me
AUTH_FROM_EMAIL=跟一口 <code@mail.genyikou.click>

# Only enable this for a private prototype when real email delivery is unavailable.
AUTH_ALLOW_DEV_CODE=false

# Added automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Browser system notifications. Generate one VAPID key pair and keep the private key secret.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:code@mail.genyikou.click
