# Generate a long random value and add it to Vercel as AUTH_TOKEN_SECRET.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Resend email delivery. The sender domain must be verified in Resend first.
RESEND_API_KEY=re_replace_me
AUTH_FROM_EMAIL=跟一口 <code@mail.genyikou.com>

# Only enable this for a private prototype when real email delivery is unavailable.
AUTH_ALLOW_DEV_CODE=false
